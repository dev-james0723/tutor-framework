+def _segmentation_review(
+    region: dict[str, object],
+    *,
+    max_seconds: float = 45.0,
+) -> dict[str, object]:
+    """Flag automatic music spans that are suspiciously long.
+
+    A long span is not automatically wrong; it is a review signal that the
+    detector may have merged multiple lecture examples. Explicit manual
+    overrides are already human-selected and are therefore not re-flagged.
+    """
+
+    if region.get("kind") != "music" or region.get("detector") == "manual_override":
+        return {"review_required": False, "reason": ""}
+    start = float(region.get("start_seconds", 0.0))
+    end = float(region.get("end_seconds", start))
+    if end - start > max_seconds:
+        return {
+            "review_required": True,
+            "reason": (
+                "automatic music region exceeds review duration; possible merged "
+                "examples require timestamp split/override review"
+            ),
+        }
+    return {"review_required": False, "reason": ""}
+
+
+def _google_failure_payload(exc: GoogleIdentificationError) -> dict[str, object]:
