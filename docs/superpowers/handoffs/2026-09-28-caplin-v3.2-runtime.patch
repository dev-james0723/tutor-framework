+import importlib.util
+import inspect
+import sys
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+SCRIPTS = ROOT / "scripts"
+sys.path.insert(0, str(SCRIPTS))
+MODULE_PATH = SCRIPTS / "lecture_audio_pipeline.py"
+
+spec = importlib.util.spec_from_file_location("lecture_audio_pipeline_test_module", MODULE_PATH)
+pipeline = importlib.util.module_from_spec(spec)
+assert spec.loader is not None
+spec.loader.exec_module(pipeline)
+
+
+class PipelinePolicyTests(unittest.TestCase):
+    def test_long_automatic_music_region_requires_segmentation_review(self):
+        region = {
+            "region_id": "region-001",
+            "kind": "music",
+            "detector": "inaSpeechSegmenter",
+            "start_seconds": 10.0,
+            "end_seconds": 74.0,
+        }
+        result = pipeline._segmentation_review(region, max_seconds=45.0)
+        self.assertTrue(result["review_required"])
+        self.assertIn("possible merged examples", result["reason"])
+
+    def test_manual_override_is_not_flagged_as_automatic_merge(self):
+        region = {
+            "region_id": "manual-music-001",
+            "kind": "music",
+            "detector": "manual_override",
+            "start_seconds": 10.0,
+            "end_seconds": 74.0,
+        }
+        result = pipeline._segmentation_review(region, max_seconds=45.0)
+        self.assertFalse(result["review_required"])
+
+    def test_pipeline_accepts_google_context_hint(self):
+        params = inspect.signature(pipeline.analyze).parameters
+        self.assertIn("google_context_hint", params)
+
+    def test_google_provider_failure_payload_keeps_attempt_history(self):
+        exc = pipeline.GoogleIdentificationError(
+            "Google audio identification returned HTTP 503",
+            [{"model": "gemini-test", "http_status": 503, "retryable": True}],
+        )
+        payload = pipeline._google_failure_payload(exc)
+        self.assertFalse(payload["available"])
+        self.assertEqual(payload["attempt_history"][0]["http_status"], 503)
+        self.assertIn("HTTP 503", payload["reason"])
+
+    def test_basic_pitch_without_calibrated_confidence_stays_human_review(self):
+        self.assertEqual(
+            pipeline._basic_pitch_evidence_state(
+                note_count=200,
+                has_calibrated_confidence=False,
+            ),
+            "requires_human_review",
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
